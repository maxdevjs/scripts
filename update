update_kitty() {
  log ${WARNING_SIGN} ${BOLD_PURPLE} "Kitty update" ${COLOR_OFF}
  
  REMOTE_VERSION=`curl -s https://api.github.com/repos/kovidgoyal/kitty/releases/latest | grep -oP '"tag_name": "\K(.*)(?=")' | cut -c2-`
  INSTALLED_VERSION=$(kitty -v 2>&1 | cut -d ' ' -f2)

  if [[ ${REMOTE_VERSION} == "" ]] ; then
    log ${CROSS_MARK} ${RED} "Check Kitty latest URL" ${COLOR_OFF}
    exit 1
  fi
  if [ $(version $INSTALLED_VERSION) -lt $(version $REMOTE_VERSION) ]; then
    log ${WARNING_SIGN} ${YELLOW} "Updating Kitty to ${REMOTE_VERSION})" ${COLOR_OFF}
    curl -L https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin
    log ${CHECK_MARK} ${GREEN} "Updated Kitty to version ${REMOTE_VERSION})" ${COLOR_OFF}
  else
    log ${CHECK_MARK} ${GREEN} "Installed version (${INSTALLED_VERSION}) is up to date (remote is ${REMOTE_VERSION})" ${COLOR_OFF}
  fi
}

