setup_vimix_themes() {
  REMOTE_VERSION=`curl -s https://api.github.com/repos/vinceliuice/${1}/releases/latest | grep -oP '"tag_name": "\K(.*)(?=")' | cut -c1-`
  FILE_INSTALLED_VERSION=$HOME/.themes/.${1}
  if [[ -f  $FILE_INSTALLED_VERSION ]];then

  INSTALLED_VERSION=$(cat $FILE_INSTALLED_VERSION)
  else
    INSTALLED_VERSION=0
  fi

  if [ $(version $INSTALLED_VERSION) -lt $(version $REMOTE_VERSION) ]; then
    REPO=https://github.com/vinceliuice/${1}
    log ${WARNING_SIGN} ${YELLOW} "Updating ${1} (current version ${INSTALLED_VERSION}) to ${REMOTE_VERSION})" ${COLOR_OFF}
    cd /tmp/
    if [[ -d $1 ]];then
      log "/tmp/$1 already exists! Deleting folder and cloning the ${REPO}"
      rm -Rf /tmp/$1
    fi

    git clone ${REPO}
    cd /tmp/${1}

    if [[ $1 =~ Vimix-gtk-themes ]]; then
      echo Vimix-gtk-themes
      ./install.sh -t all -s all
    fi
    if [[ $1 =~ Vimix-icon-theme ]]; then
      echo Vimix-icon-theme
      ./install.sh -a
      echo "${REMOTE_VERSION}" > $HOME/.themes/.${1}
    log ${CHECK_MARK} ${GREEN} "${1} themes update!" ${COLOR_OFF}
    fi
  else
    log ${CHECK_MARK} ${GREEN} "${1} themes already up-to-date!" ${COLOR_OFF}
  fi
}

update_themes() {
  log ${WARNING_SIGN} ${BOLD_PURPLE} "Themes update" ${COLOR_OFF}
  setup_vimix_themes Vimix-gtk-themes
  setup_vimix_themes Vimix-icon-theme
  log ${CHECK_MARK} ${GREEN} "Themes updated!" ${COLOR_OFF}
}

