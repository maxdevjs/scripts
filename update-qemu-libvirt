#!/usr/bin/env sh

# Disable the monolithic components
sudo systemctl disable --now libvirtd.service libvirtd.socket
sudo systemctl mask libvirtd.service

# https://libvirtd.com/man/modern-libvirt/
eopkg history | grep libvirt

# Enable and start the modular QEMU and Network sockets
sudo systemctl enable --now virtqemud.socket virtnetworkd.socket virtstoraged.socket virtsecret_d.socket
# Enable the proxy daemon that links old app configs to new sockets
sudo systemctl enable --now virtproxyd.socket
# Start the primary driver service
sudo systemctl start virtqemud.service
# Verifying it Works
sudo systemctl status virtqemud libvirtd
ls -l /var/run/libvirt/virtnetworkd-sock

systemctl list-unit-files 'virt*d*'

